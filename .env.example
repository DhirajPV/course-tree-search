# Base URL of the course tree search service, read by the app at build time.
#
# /api is proxied by the Vite dev and preview servers to
# https://coursetreesearch-service-sandbox.dev.tophat.com with the /api prefix
# stripped (see vite.config.ts), so the browser never depends on the sandbox
# sending CORS headers. Copy this file to .env to override it.
VITE_API_BASE_URL=/api
